#!/usr/bin/env bash
set -euo pipefail
export OSX_KVM_VM_ROOT=${OSX_KVM_VM_ROOT:-${CIV3R_MACVM_ROOT:-/mnt/datasets/macvm}}
if command -v osx-kvm-manager >/dev/null 2>&1; then exec osx-kvm-manager "$@"; fi
vm_flake=${CIV3R_MACVM_FLAKE:-git+ssh://git@github.com/sirati/nix-osx-kvm.git?rev=bc6f76cff637fc7dffa9eb00d3bb1af02d01435a}
exec nix run "$vm_flake#manager" -- "$@"
