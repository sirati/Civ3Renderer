#!/usr/bin/env bash
# Measures the game's text font (Lucida Sans, as jgl.dll draws it with GDI)
# on Windows — ClearType, per colour channel — into glyph sheets for the
# tools and processes that cannot ask Windows' GDI themselves (Linux, Wine):
# civ3-assets reads them from $CIV3R_FONT_CACHE (default
# ~/.cache/civ3r/fonts). font-sheet.exe runs in a throwaway Windows VM
# (~/winvm), as Windows' own text rendering is what the game shows there.
#
#   tools/gen-civ3-fonts [--wine] [SIZES...]      (run inside `nix develop`)
#
# The sheets also hold each character's text extent, the width `jgl.dll` measures it with
# (`GetTextExtentPoint32A` on a monochrome memory DC; the plates of the city labels are
# sized by it, docs §10.8). On Windows it equals the advance; Wine's GDI measures other
# widths. `--wine` makes the sheets in Wine instead of the VM (seconds, no VM), for
# checking what a game running under Wine drew: set CIV3R_FONT_CACHE to a folder of its own,
# since Wine's glyphs are not Windows'.
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
install=${CIV3_INSTALL:-/mnt/datasets/winvm/civ3-src/Civilization III Complete}
out=${CIV3R_FONT_CACHE:-$HOME/.cache/civ3r/fonts}
target=${CARGO_TARGET_DIR:-$repo/target}
vm=${CIV3R_FONT_VM:-fontsheets}
# The sizes made: the game's own, 8 to 24 pixels (text at other zooms is drawn from the
# font's outlines; a size without a sheet takes the nearest, civ3_assets::fonts::nearest_height).
default_sizes="$(seq -s ' ' 8 24)"
wine=0
if [ "${1:-}" = --wine ]; then wine=1; shift; fi
mkdir -p "$out"
cargo build -q --release -p gdi-text --target x86_64-pc-windows-gnu --bin font-sheet
if [ $wine = 1 ]; then
  # Z: is the host's root in a Wine prefix.
  winpath() { printf 'Z:%s' "${1//\//\\}"; }
  for size in ${@:-$default_sizes}; do
    for style in "0 0 -" "700 0 -w700" "0 1 -i" "700 1 -w700-i"; do
      read -r weight italic suffix <<<"$style"
      [ "$suffix" = - ] && suffix=
      "$repo/tools/wine-run" "$target/x86_64-pc-windows-gnu/release/font-sheet.exe" "$(winpath "$install/LSANS.TTF")" "Lucida Sans" "$size" "$weight" \
        "$(winpath "$out/Lucida_Sans-$size$suffix.png")" 32 255 0 "$italic" > /dev/null
    done
  done
  echo "wrote $(ls "$out"/*.toml | wc -l) fonts to $out (Wine)"
  exit 0
fi
stage=$(mktemp -d -p /mnt/datasets/winvm civ3-fonts.XXXXXX)
trap '~/winvm/bin/winvm down "$vm" >/dev/null 2>&1 || true; rm -rf "$stage"' EXIT
cp "$target/x86_64-pc-windows-gnu/release/font-sheet.exe" "$install/LSANS.TTF" "$stage/"
mkdir "$stage/out"
# Regular, bold, italic and bold italic (file names as civ3-assets'
# `cache_stem`: -w<weight> for bold, -i for italic).
{
  echo '@echo off'
  for size in ${@:-$default_sizes}; do
    for style in "0 0 -" "700 0 -w700" "0 1 -i" "700 1 -w700-i"; do
      read -r weight italic suffix <<<"$style"
      [ "$suffix" = - ] && suffix=
      echo "Z:\\font-sheet.exe Z:\\LSANS.TTF \"Lucida Sans\" $size $weight Z:\\out\\Lucida_Sans-$size$suffix.png 32 255 0 $italic"
    done
  done
  echo 'echo done> Z:\out\done.txt'
} | sed 's/$/\r/' > "$stage/run.cmd"
# (No program window: the smallest screen the VM takes.)
~/winvm/bin/winvm up "$vm" --share "$stage" --mem 4G --res 800x600
# In the interactive session (the desktop's font smoothing settings apply),
# then wait for it to finish.
~/winvm/bin/winvm ps "$vm" - <<'EOF'
schtasks /Create /TN fontsheets /TR "cmd /c Z:\run.cmd > Z:\out\log.txt 2>&1" /SC ONCE /ST 23:59 /IT /F | Out-Null
schtasks /Run /TN fontsheets | Out-Null
for ($i = 0; $i -lt 1800 -and -not (Test-Path Z:\out\done.txt); $i++) { Start-Sleep 1 }
EOF
[ -f "$stage/out/done.txt" ] || { echo "font sheets: not finished, see $stage/out/log.txt" >&2; cat "$stage/out/log.txt" >&2 || true; exit 1; }
cp "$stage"/out/*.png "$stage"/out/*.toml "$out/"
echo "wrote $(ls "$stage"/out/*.toml | wc -l) fonts to $out"
