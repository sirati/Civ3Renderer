        self.assertEqual(preserved[0].read_bytes(), b"interrupted new overlay")
        self.cli("verify", "partial")

    def test_snapshot_preserves_selected_boot_profile(self):
        profile = self.root / "support/OpenCore-test.qcow2"
        subprocess.run(["qemu-img", "create", "-f", "qcow2", str(profile), "2M"], check=True, capture_output=True)
        self.cli("clone", "one", "--template", "clean")
