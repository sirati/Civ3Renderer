    def test_audio_profile_clones_without_instance_host_mappings(self):
        self.cli("clone", "audio", "--template", "clean")
        extra = ["-object", "memory-backend-file,id=private-host-map,mem-path=/private/test-map,size=1M"]
        self.cli("configure", "audio", "--audio", "usb-null", "--ram-mib", "3072",
                 "--shared-ram", "on", "--qemu-extra", json.dumps(extra))
        self.cli("snapshot", "audio", "audio-ready")
        self.cli("clone", "audio-copy", "--template", "audio-ready")
        source = json.loads((self.root / "instances/audio/instance.json").read_text())
        clone = json.loads((self.root / "instances/audio-copy/instance.json").read_text())
        self.assertEqual(clone["audio_profile"], "usb-null")
        self.assertNotIn("qemu_extra", clone)
        self.assertNotIn("shared_ram", clone)
        self.assertNotEqual(source["ram_mib"], clone["ram_mib"])
        for field in ("uuid", "mac", "ssh_port", "vnc_port"):
            self.assertNotEqual(source[field], clone[field])
        spec = importlib.util.spec_from_file_location("macvm_audio", SOURCE)
        module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
        store = module.Store(self.root)
        path, item = store.instance("audio-copy")
        command = store.qemu_command(path, item)
        self.assertIn("none,id=macvm-audio", command)
        self.assertIn("usb-audio,id=macvm-usb-audio,bus=xhci.0,audiodev=macvm-audio", command)
        self.assertNotIn(extra[-1], command)
        self.cli("configure", "audio-copy", "--audio", "none")
        path, item = store.instance("audio-copy")
        self.assertNotIn("none,id=macvm-audio", store.qemu_command(path, item))
        item["audio_profile"] = "unknown-host-audio"
        with self.assertRaisesRegex(module.Error, "Unsupported VM audio profile"):
            store.qemu_command(path, item)

    def test_reset_recovery_restores_audio_profile_and_preserves_history(self):
        self.cli("clone", "audio", "--template", "clean")
        self.cli("configure", "audio", "--audio", "usb-null")
        self.cli("snapshot", "audio", "audio-ready")
        self.cli("configure", "audio", "--audio", "none", "--ram-mib", "3072")
        path = self.root / "instances/audio"
        original = json.loads((path / "instance.json").read_text())
        spec = importlib.util.spec_from_file_location("macvm_audio_reset", SOURCE)
        module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
        real = module.os.rename
        def interrupted(source, target):
            real(source, target)
            raise OSError("audio reset interruption")
        with mock.patch.object(module.os, "rename", interrupted):
            with self.assertRaisesRegex(OSError, "audio reset interruption"):
                module.Store(self.root).reset("audio", "audio-ready")
        self.cli("recover", "audio")
        restored = json.loads((path / "instance.json").read_text())
        self.assertEqual(restored["audio_profile"], "usb-null")
        for field in ("uuid", "mac", "ssh_port", "vnc_port", "ram_mib"):
            self.assertEqual(original[field], restored[field])
        archived = json.loads(next(path.glob("history/*/instance.json")).read_text())
        self.assertEqual(archived["audio_profile"], "none")
        self.cli("reset", "audio", "--to", "clean")
        self.assertEqual(json.loads((path / "instance.json").read_text())["audio_profile"], "none")

    def test_shared_memory_budget_includes_configured_ram_and_overhead(self):
        spec = importlib.util.spec_from_file_location("macvm", SOURCE)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        self.assertEqual(module.DEFAULT_RAM_MIB, 6144)
        self.assertEqual(module.configured_ram(["qemu", "-m", "12G", "-m", "size=6144M,slots=2"]), 6 * 1024**3)
        self.assertLessEqual(module.memory_admission([], 6 * 1024**3), 10_000_000_000)
        self.assertLessEqual(module.memory_admission([6*1024**3], 1024**3), 10_000_000_000)
        with self.assertRaisesRegex(module.Error, "above the shared"):
            module.memory_admission([6*1024**3], 1024**3, observed_usage=9_000_000_000, idle_clean_cache=8_000_000_000)
        self.assertLessEqual(module.memory_admission([], 6*1024**3, observed_usage=9_000_000_000, idle_clean_cache=8_000_000_000), 10_000_000_000)
        with self.assertRaisesRegex(module.Error, "above the shared"):
            module.memory_admission([], 6*1024**3, observed_usage=9_000_000_000, idle_clean_cache=0)
        self.assertEqual(module.clean_file_cache({"file":900,"shmem":100,"file_dirty":20,"file_writeback":30}), 750)
        plan = module.planned_clean_reclaim([4*1024**3], 3*1024**3, 8_760_000_000, 4_350_000_000)
        self.assertGreater(plan, 0)
        self.assertLessEqual(plan, 4*1024**3)
        self.assertEqual(module.planned_clean_reclaim([4*1024**3], 3*1024**3, 8_760_000_000, 1_000_000), 0)
        with self.assertRaisesRegex(module.Error, "above the shared"):
            module.planned_clean_reclaim([4*1024**3], 6*1024**3, 8_760_000_000, 4_350_000_000)
        with self.assertRaisesRegex(module.Error, "above the shared"):
            module.memory_admission([6 * 1024**3], 6 * 1024**3)
        with self.assertRaisesRegex(module.Error, "above the shared"):
            module.memory_admission([8 * 1024**3], 2 * 1024**3)
        self.cli("clone", "budget", "--template", "clean")
        item = json.loads((self.root / "instances/budget/instance.json").read_text())
        self.assertEqual(item["ram_mib"], 6144)

    def test_first_start_activates_configured_inactive_slice_then_rechecks_limits(self):
        spec = importlib.util.spec_from_file_location("macvm", SOURCE)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        state = {"active": False, "started": 0}
        calls = []
        def systemctl(args, **kwargs):
            calls.append(args)
            if args == ["systemctl", "--user", "start", "c3r-vms.slice"]:
                state["active"] = True
                state["started"] += 1
                return subprocess.CompletedProcess(args, 0, stdout="", stderr="")
            self.assertEqual(args[:4], ["systemctl", "--user", "show", "c3r-vms.slice"])
            output = "LoadState=loaded\nMemoryMax=10000000000\nMemorySwapMax=0\nMemoryCurrent=0\n"
            output += "ActiveState=active\nControlGroup=/c3r.slice/c3r-vms.slice\n" if state["active"] else "ActiveState=inactive\nControlGroup=\n"
            return subprocess.CompletedProcess(args, 0, stdout=output, stderr="")
        with mock.patch.object(module, "run", systemctl):
            info = module.Store(self.root).slice_info()
        self.assertEqual(state["started"], 1)
        self.assertEqual(len(calls), 3)
        self.assertEqual(info["ActiveState"], "active")
        self.assertEqual(info["MemoryMax"], "10000000000")
        self.assertEqual(info["MemorySwapMax"], "0")

    def test_inactive_slice_with_missing_or_wrong_limits_is_never_started(self):
        spec = importlib.util.spec_from_file_location("macvm", SOURCE)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        for override in ({"LoadState":"not-found"}, {"MemoryMax":"11000000000"}, {"MemorySwapMax":"1"}):
            with self.subTest(config=override):
                config = {"LoadState":"loaded", "MemoryMax":"10000000000", "MemorySwapMax":"0", "MemoryCurrent":"0", "ActiveState":"inactive", "ControlGroup":""}
                config.update(override)
                result = subprocess.CompletedProcess([], 0, stdout="".join(f"{key}={value}\n" for key,value in config.items()), stderr="")
                with mock.patch.object(module, "run", return_value=result) as call:
                    with self.assertRaisesRegex(module.Error, "must be configured"):
                        module.Store(self.root).slice_info()
                self.assertEqual(call.call_count, 1)

    def test_start_uses_capped_service_without_daemonizing_qemu(self):
        spec = importlib.util.spec_from_file_location("macvm", SOURCE)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        self.cli("clone", "managed", "--template", "clean")
        store = module.Store(self.root)
        real_run = module.run
        launches = []
        def no_launch(args, **kwargs):
            if args[0] == "systemd-run":
                launches.append(args)
                return subprocess.CompletedProcess(args, 0, stdout="", stderr="")
            return real_run(args, **kwargs)
        with mock.patch.object(module, "run", no_launch), mock.patch.object(module.Store, "admit", return_value=7*1024**3), mock.patch.object(module.Store, "in_own_service", return_value=False), mock.patch.object(module.Store, "active", side_effect=[None, None, 123]):
            store.start("managed")
        self.assertEqual(len(launches), 1)
        self.assertIn("--slice=c3r-vms.slice", launches[0])
        self.assertIn("--unit=c3r-macos-managed.service", launches[0])
        self.assertIn("--service-type=exec", launches[0])
        self.assertIn("--property=MemorySwapMax=0", launches[0])
        self.assertNotIn("-daemonize", launches[0])
        meta = json.loads((self.root / "instances/managed/last-start.json").read_text())
        self.assertEqual(meta["shared_memory_max_bytes"], 10_000_000_000)

