#!/usr/bin/env python3
"""Exercise the real qcow2 clone/snapshot/reset paths using small synthetic disks."""
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
sys.dont_write_bytecode = True
from unittest import mock

SOURCE = Path(__file__).resolve().with_name("macos-vm.py")


class VmTemplates(unittest.TestCase):
    def setUp(self):
        parent = os.environ.get("CIV3R_VM_TEST_TMPDIR", "/mnt/datasets/c3r-build/macos-port")
        self.temp = tempfile.TemporaryDirectory(prefix="template-test-", dir=parent)
        self.path = Path(self.temp.name)
        self.root = self.path / "store"
        self.legacy = self.path / "legacy"
        (self.legacy / "helpers").mkdir(parents=True)
        subprocess.run(["qemu-img", "create", "-f", "qcow2", str(self.legacy / "mac_hdd_ng.img"), "16M"], check=True, capture_output=True)
        subprocess.run(["qemu-img", "create", "-f", "qcow2", str(self.legacy / "helpers/OpenCore-debug.qcow2"), "1M"], check=True, capture_output=True)
        for file in ["OVMF_VARS-1920x1080.fd", "OVMF_CODE_4M.fd", "id_ed25519", "id_ed25519.pub"]:
            (self.legacy / file).write_bytes(b"private-test-file")
        (self.legacy / "credentials.json").write_text('{"user":"c3r"}')
        self.cli("import", str(self.legacy), "clean", "--clean-shutdown")

    def tearDown(self):
        self.temp.cleanup()

    def cli(self, *args, success=True):
        result = subprocess.run([sys.executable, str(SOURCE), "--root", str(self.root), *args], capture_output=True, text=True)
        if success:
            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        else:
            self.assertNotEqual(result.returncode, 0, result.stdout + result.stderr)
        return result

    def io(self, disk, command):
        result = subprocess.run(["qemu-io", *(["-r"] if command.startswith("read ") else []), "-f", "qcow2", "-c", command, str(disk)], capture_output=True, text=True)
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)

    def test_clone_is_small_and_private(self):
        self.cli("clone", "one", "--template", "clean")
        self.cli("clone", "two", "--template", "clean")
        first = self.root / "instances/one"
        second = self.root / "instances/two"
        a = json.loads((first / "instance.json").read_text())
        b = json.loads((second / "instance.json").read_text())
        for field in ("ssh_port", "vnc_port", "mac", "uuid"):
            self.assertNotEqual(a[field], b[field])
        self.assertLess((first / "disk.qcow2").stat().st_blocks * 512, 2 * 1024 * 1024)
        self.io(first / "disk.qcow2", "write -P 0x5a 0 512")
        self.io(second / "disk.qcow2", "read -P 0 0 512")
        self.io(self.root / "templates/clean/disk.qcow2", "read -P 0 0 512")
        (first / "OVMF_VARS.fd").write_bytes(b"changed")
        self.assertEqual((second / "OVMF_VARS.fd").read_bytes(), b"private-test-file")
        self.cli("verify", "one")

    def test_named_snapshot_and_reset_preserve_prior_state(self):
        self.cli("clone", "one", "--template", "clean")
        disk = self.root / "instances/one/disk.qcow2"
        self.io(disk, "write -P 0x11 0 512")
        self.cli("snapshot", "one", "prepared")
        self.io(disk, "write -P 0x22 0 512")
        nvram = disk.with_name("OVMF_VARS.fd")
        nvram.write_bytes(b"writable-firmware")
        self.cli("reset", "one", "--to", "prepared")
        self.io(disk, "read -P 0x11 0 512")
        self.assertEqual(nvram.read_bytes(), b"private-test-file")
        archives = list(disk.parent.glob("history/*/disk.qcow2"))
        self.assertEqual(len(archives), 1)
        self.io(archives[0], "read -P 0x22 0 512")
        self.assertEqual(archives[0].with_name("OVMF_VARS.fd").read_bytes(), b"writable-firmware")
        self.cli("clone", "two", "--template", "prepared")
        self.io(self.root / "instances/two/disk.qcow2", "read -P 0x11 0 512")
        self.cli("verify")
        self.cli("verify", "one")

    def test_interrupted_reset_recovers_disk_and_nvram_together(self):
        spec = importlib.util.spec_from_file_location("macvm", SOURCE)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        real_rename = module.os.rename
        for phase in range(1, 5):
            with self.subTest(rename=phase):
                name = f"phase{phase}"
                self.cli("clone", name, "--template", "clean")
                disk = self.root / "instances" / name / "disk.qcow2"
                self.io(disk, "write -P 0x33 0 512")
                disk.with_name("OVMF_VARS.fd").write_bytes(b"old-firmware")
                count = [0]
                def interrupted(source, target):
                    real_rename(source, target)
                    count[0] += 1
                    if count[0] == phase:
                        raise OSError("simulated interruption")
                with mock.patch.object(module.os, "rename", interrupted):
                    with self.assertRaisesRegex(OSError, "simulated interruption"):
                        module.Store(self.root).reset(name, "clean")
                self.assertTrue(disk.with_name("reset-pending.json").exists())
                self.cli("recover", name)
                self.assertFalse(disk.with_name("reset-pending.json").exists())
                self.io(disk, "read -P 0 0 512")
                self.assertEqual(disk.with_name("OVMF_VARS.fd").read_bytes(), b"private-test-file")
                old = next(disk.parent.glob("history/*/disk.qcow2"))
                self.io(old, "read -P 0x33 0 512")
                self.assertEqual(old.with_name("OVMF_VARS.fd").read_bytes(), b"old-firmware")
                self.cli("verify", name)

    def test_reset_error_after_journal_commit_keeps_recovery_files(self):
        spec = importlib.util.spec_from_file_location("macvm", SOURCE)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        self.cli("clone", "journal", "--template", "clean")
        disk = self.root / "instances/journal/disk.qcow2"
        self.io(disk, "write -P 0x44 0 512")
        real_write = module.write
        def interrupted(path, value):
            real_write(path, value)
            if Path(path).name == "reset-pending.json":
                raise OSError("interrupted after journal commit")
        with mock.patch.object(module, "write", interrupted):
            with self.assertRaisesRegex(OSError, "journal commit"):
                module.Store(self.root).reset("journal", "clean")
        self.assertTrue(disk.with_name("disk.next.qcow2").exists())
        self.cli("recover", "journal")
        self.io(disk, "read -P 0 0 512")
        old = next(disk.parent.glob("history/*/disk.qcow2"))
        self.io(old, "read -P 0x44 0 512")

    def test_snapshot_recovers_all_commit_boundaries_without_manifest_rollback(self):
        spec = importlib.util.spec_from_file_location("macvm", SOURCE)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        phases = ("journal", "rename", "overlay", "template", "instance", "clean")
        for phase in phases:
            with self.subTest(phase=phase):
                name, template = "snap-" + phase, "saved-" + phase
                self.cli("clone", name, "--template", "clean")
                self.cli("configure", name, "--audio", "usb-null")
                path = self.root / "instances" / name
                self.io(path / "disk.qcow2", "write -P 0x55 0 512")
                (path / "OVMF_VARS.fd").write_bytes(b"snapshot-firmware")
                real_write, real_rename, real_overlay = module.write, module.os.rename, module.Store.overlay
                def interrupted_write(file, value):
                    real_write(file, value)
                    filename = Path(file).name
                    target = {"journal": "snapshot-pending.json", "template": "template.json", "instance": "instance.json", "clean": "clean-shutdown.json"}.get(phase)
                    if filename == target:
                        raise OSError("snapshot interruption")
                def interrupted_rename(source, target):
                    real_rename(source, target)
                    if phase == "rename" and Path(target) == self.root / "templates" / template / "disk.qcow2":
                        raise OSError("snapshot interruption")
                def interrupted_overlay(store, target, base):
                    real_overlay(store, target, base)
                    if phase == "overlay":
                        raise OSError("snapshot interruption")
                with mock.patch.object(module, "write", interrupted_write), mock.patch.object(module.os, "rename", interrupted_rename), mock.patch.object(module.Store, "overlay", interrupted_overlay):
                    with self.assertRaisesRegex(OSError, "snapshot interruption"):
                        module.Store(self.root).snapshot(name, template)
                self.assertTrue((path / "snapshot-pending.json").exists())
                self.cli("recover", name)
                self.assertFalse((path / "snapshot-pending.json").exists())
                self.assertEqual(json.loads((path / "instance.json").read_text())["template"], template)
                self.assertEqual(json.loads((self.root / "templates" / template / "template.json").read_text())["audio_profile"], "usb-null")
                self.assertEqual(json.loads((path / "instance.json").read_text())["audio_profile"], "usb-null")
                self.io(path / "disk.qcow2", "read -P 0x55 0 512")
                self.io(self.root / "templates" / template / "disk.qcow2", "read -P 0x55 0 512")
                self.assertEqual((self.root / "templates" / template / "OVMF_VARS.fd").read_bytes(), b"snapshot-firmware")
                self.assertEqual((path / "OVMF_VARS.fd").read_bytes(), b"snapshot-firmware")
                self.cli("verify", name)

    def test_snapshot_survives_process_death_after_original_disk_move(self):
        self.cli("clone", "killed", "--template", "clean")
        path = self.root / "instances/killed"
        self.io(path / "disk.qcow2", "write -P 0x66 0 512")
        script = r"""
import importlib.util, os, sys
from pathlib import Path
sys.dont_write_bytecode = True
spec=importlib.util.spec_from_file_location('macvm', sys.argv[1])
m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
real=m.os.rename
def killed(source,target):
    real(source,target)
    if Path(target)==Path(sys.argv[2])/'templates/killed-save/disk.qcow2': os._exit(73)
m.os.rename=killed
m.Store(sys.argv[2]).snapshot('killed','killed-save')
"""
        result = subprocess.run([sys.executable, "-c", script, str(SOURCE), str(self.root)], capture_output=True)
        self.assertEqual(result.returncode, 73)
        self.assertFalse((path / "disk.qcow2").exists())
        state = json.loads(self.cli("status").stdout)
        self.assertEqual(state["instances"][0]["pending_transaction"], "snapshot")
        self.assertIsNone(state["instances"][0]["allocated_bytes"])
        self.cli("recover", "killed")
        self.io(path / "disk.qcow2", "read -P 0x66 0 512")
        self.cli("verify", "killed")

    def test_snapshot_preserves_partial_overlay_and_recovers_original(self):
        spec = importlib.util.spec_from_file_location("macvm", SOURCE)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        self.cli("clone", "partial", "--template", "clean")
        path = self.root / "instances/partial"
        self.io(path / "disk.qcow2", "write -P 0x77 0 512")
        def broken_overlay(store, target, base):
            Path(target).write_bytes(b"interrupted new overlay")
            raise OSError("qemu-img creation interrupted")
        with mock.patch.object(module.Store, "overlay", broken_overlay):
            with self.assertRaisesRegex(OSError, "creation interrupted"):
                module.Store(self.root).snapshot("partial", "partial-save")
