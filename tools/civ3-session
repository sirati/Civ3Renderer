#!/usr/bin/env bash
# Drives a Civilization III session in Wine on a private headless Wayland
# session (~/winvm/bin/wlh), for tests.
#
#   tools/civ3-session start            start sway + the game (fullscreen), wait for the menu
#   tools/civ3-session newgame          New Game with the saved settings, found nothing, wait for turn 1
#   tools/civ3-session scenario         Conquests scenario "WW2 in the Pacific" (as China), wait for turn 1
#   tools/civ3-session load NAME       Load Game screen: load save NAME (file in the install's Saves folder, from the main menu)
#   tools/civ3-session goto X Y        centre the view on tile (X, Y) via the minimap (game running, map showing)
#   tools/civ3-session trace [out.txt]  have civ3-bridge write one frame's draw list
#   tools/civ3-session shot [out.png]   screenshot of the session
#   tools/civ3-session state            print the bridge's log tail
#   tools/civ3-session stop             end the game
#
# The menu coordinates below are for the game at 1920x1080 (KeepRes=1).
# CIV3_SESSION_SCALE=S: the game is shown S times larger (a 1920x1080 game
# on a 3840x2160 output, tools/civ3-play --scale 2; 1.5 too): input and
# screenshot probes are scaled to match.
#
# The game's own window stays shown next to the viewer here
# (CIV3R_GAME_WINDOW=show, unless set otherwise): tests look at both.
set -euo pipefail
WLH=${WLH:-$HOME/winvm/bin/wlh}
CIV3_WINE=${CIV3_WINE:-$HOME/winvm/civ3/civ3-wine}
GAME=${CIV3_GAME:-"/mnt/datasets/winvm/wine-civ3/drive_c/Games/Civilization III Complete/Conquests"}
eval "$("$WLH" env)"
export CIV3R_GAME_WINDOW=${CIV3R_GAME_WINDOW:-show}
S=${CIV3_SESSION_SCALE:-1}
# Pointer moves and clicks at game pixels (scaled to the output's).
at() { awk -v v="$1" -v s="$S" 'BEGIN { printf "%d", (v + 0.5) * s }'; }
move() { "$WLH" move "$(at "$1")" "$(at "$2")"; }
click() { "$WLH" click "$(at "$1")" "$(at "$2")" "${@:3}"; }

wait_for_log() { # pattern timeout
  local t=0
  until grep -q "$1" "$GAME/civ3-bridge.log" 2>/dev/null; do
    sleep 1; t=$((t + 1))
    [ $t -lt "$2" ] || { echo "timeout waiting for '$1'" >&2; return 1; }
  done
}

case ${1:-} in
start)
  "$WLH" start >/dev/null
  "$CIV3_WINE" kill 2>/dev/null || true
  rm -f "$GAME/civ3-bridge.log" "$GAME/civ3-trace.request" "$GAME/civ3-trace.txt"
  "$WLH" run "$CIV3_WINE" fullscreen >/dev/null
  wait_for_log "detected build" 60
  sleep 8   # main menu up
  echo "game at main menu"
  ;;
newgame)
  # Every button needs a hover first: the first click after the pointer jumps
  # somewhere may only hover, so move there, wait, then click.
  hclick() { move "$1" "$2"; sleep 1; click "$1" "$2"; }
  # Main menu: New Game is at y=498 with or without the "Play Last World" entry
  # (that one sits above it, at y=460, and only exists in some prefixes). The
  # first click on the menu often only hovers, so repeat until the screen has
  # left the menu: its probe area (bottom left of the panel) is near black
  # there, and light parchment on the world setup screen.
  on_menu() {
    "$WLH" shot "${TMPDIR:-/tmp}/civ3-session-probe.png" >/dev/null
    nix shell --impure --expr 'let p = import <nixpkgs> {}; in p.python3.withPackages (ps: [ps.pillow ps.numpy])' -c python3 -c '
import sys
from PIL import Image
import numpy as np
s = float(sys.argv[2])
a = np.asarray(Image.open(sys.argv[1]).convert("RGB"))[int(860*s):int(900*s), int(480*s):int(600*s)]
sys.exit(0 if a.mean() < 90 else 1)' "${TMPDIR:-/tmp}/civ3-session-probe.png" "$S"
  }
  for _ in 1 2 3 4; do
    hclick 708 498; sleep 3   # main menu: New Game
    on_menu || break
  done
  if on_menu; then echo "stuck on the main menu" >&2; exit 1; fi
  sleep 1
  hclick 1416 895; sleep 4    # world: OK
  hclick 1416 895; sleep 10   # players: OK, world generation
  hclick 1233 256; sleep 3    # dismiss "Dawn of Civilization"
  wait_for_log "calls: draw_tiles [1-9]" 30
  echo "turn 1"
  ;;
scenario)
  move 710 612; sleep 1
  click 710 612; sleep 5     # Conquests! (the first click may only hover)
  click 710 612; sleep 4     # (if the list is already up this selects a harmless row)
  click 680 553; sleep 2     # select "9 WWII in the Pacific.biq"
  click 1421 901; sleep 6    # scenario list: OK
  click 1416 895; sleep 25   # player setup (China): OK, scenario loads
  click 1861 1035; sleep 4   # dismiss the scenario intro text
  echo "turn 1"
  ;;
load)
  name=${2:?usage: load NAME}
  [ -n "$(find "$GAME/Saves" -maxdepth 1 -iname "$name" -print -quit)" ] || { echo "no such save: $GAME/Saves/$name" >&2; exit 1; }
  # The Load Game dialog opens with its file name field selected, so typing
  # replaces it (the field takes the keys lower-cased; the file system is
  # case-insensitive under Wine). Only letters, digits, enter and esc are safe
  # key names for the input daemon, so no backspace/home/ctrl.
  # The first click on a menu entry may only hover: hover first, then click
  # until the dialog (its parchment box, bright at the probe spot) is up.
  probe() { # x y min_mean : screenshot region mean brightness >= min_mean
    "$WLH" shot "${TMPDIR:-/tmp}/civ3-session-probe.png" >/dev/null
    nix shell --impure --expr 'let p = import <nixpkgs> {}; in p.python3.withPackages (ps: [ps.pillow ps.numpy])' -c python3 -c '
import sys
from PIL import Image
import numpy as np
x, y, m = map(int, sys.argv[2:5])
s = float(sys.argv[5])
a = np.asarray(Image.open(sys.argv[1]).convert("RGB"))[int(y*s):int((y+20)*s), int(x*s):int((x+20)*s)]
sys.exit(0 if a.mean() >= m else 1)' "${TMPDIR:-/tmp}/civ3-session-probe.png" "$1" "$2" "$3" "$S"
  }
  move 710 574; sleep 1
  for _ in 1 2 3 4; do
    click 710 574; sleep 3
    probe 900 716 180 && break   # parchment of the Load Game box
  done
  probe 900 716 180 || { echo "Load Game dialog did not open (not at the main menu?)" >&2; exit 1; }
  "$WLH" type "$name"; sleep 1
  "$WLH" key enter    # load; the "Saved Game" summary box (parchment at its bottom left) comes up
  t=0
  until probe 720 235 190; do
    sleep 1; t=$((t + 1))
    [ $t -lt 90 ] || { echo "no summary box after loading $name" >&2; exit 1; }
  done
  sleep 1
  "$WLH" key enter; sleep 3     # dismiss it
  # The bridge only logs call counts for the first minute, so wait for the
  # map by asking for a trace (it is only written once the map is drawn).
  t=0
  until "$0" trace "${TMPDIR:-/tmp}/civ3-load.txt" >/dev/null 2>&1 && [ "$(grep -c '^draw' "${TMPDIR:-/tmp}/civ3-load.txt")" -gt 0 ]; do
    t=$((t + 1))
    [ $t -lt 12 ] || { echo "timeout waiting for the map of $name" >&2; exit 1; }
  done
  echo "loaded $name"
  ;;
goto)
  # Centre the view on tile (X, Y) with a click on the minimap (bottom left, 1920x1080:
  # interior x 30..260, y 959..1066, stretched over the whole map), then check
  # the trace's `view camera` and correct. Succeeds when the tile centre is on
  # screen, clear of the corner panels (near the map's top/bottom edge the
  # camera is clamped, so it may not be centred).
  tx=${2:?usage: goto X Y}; ty=${3:?usage: goto X Y}
  g=${TMPDIR:-/tmp}/civ3-goto.txt
  "$0" trace "$g" >/dev/null
  read -r _ mw mh wrapx wrapy < <(grep "^map " "$g" | awk "{print \$1, \$2, \$3, \$5, \$6}")
  tw=$((mw * 64)); th=$((mh * 32))
  wx=$((tx * 64 + 64)); wy=$((ty * 32 + 32))
  for _ in 1 2 3 4; do
    read -r mx my < <(awk -v wx=$wx -v wy=$wy -v tw=$tw -v th=$th 'BEGIN{
      x=int(29.5+((wx%tw+tw)%tw)/tw*230+0.5); y=int(959.5+((wy%th+th)%th)/th*107+0.5);
      if(x<31)x=31; if(x>259)x=259; if(y<960)y=960; if(y>1065)y=1065; print x, y}')
    move $mx $my; sleep 0.5; click $mx $my; sleep 2; move 960 200; sleep 1
    "$0" trace "$g" >/dev/null
    read -r cx cy < <(grep '^view camera' "$g" | awk '{print $3, $4}')
    dx=$((wx - cx)); dy=$((wy - cy))
    if [ "$wrapx" = 1 ]; then dx=$(( ((dx % tw) + tw) % tw )); [ $dx -le $((tw / 2)) ] || dx=$((dx - tw)); fi
    if [ "$wrapy" = 1 ]; then dy=$(( ((dy % th) + th) % th )); [ $dy -le $((th / 2)) ] || dy=$((dy - th)); fi
    if [ $dx -ge 100 ] && [ $dx -le 1820 ] && [ $dy -ge 80 ] && [ $dy -le 900 ]; then
      echo "tile $tx,$ty at screen $dx,$dy (camera $cx $cy)"; exit 0
    fi
    # aim the next click off by the miss
    wx=$((wx + dx - 960)); wy=$((wy + dy - 540))
  done
  echo "goto $tx,$ty failed: camera $cx $cy, tile at screen $dx,$dy" >&2; exit 1
  ;;
trace)
  out=${2:-$PWD/civ3-trace.txt}
  rm -f "$GAME/civ3-trace.txt"
  touch "$GAME/civ3-trace.request"
  # The game redraws the map continuously (animations), so a frame comes soon.
  for _ in $(seq 100); do [ -f "$GAME/civ3-trace.txt" ] && [ ! -f "$GAME/civ3-trace.request" ] && break; sleep 0.1; done
  [ -f "$GAME/civ3-trace.txt" ] || { echo "no trace written" >&2; exit 1; }
  cp "$GAME/civ3-trace.txt" "$out"
  echo "$out ($(grep -c '^draw' "$out") draws)"
  ;;
shot) "$WLH" shot "${2:-$PWD/civ3-shot.png}" ;;
state) tail -n "${2:-20}" "$GAME/civ3-bridge.log" ;;
stop) "$CIV3_WINE" kill 2>/dev/null || true; echo stopped ;;
*) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
esac
