#!/usr/bin/env bash
# Builds the unixlib fixtures into OUT, laid out as a WINEDLLPATH directory:
# i386-windows/NAME.dll (marked builtin) with x86_64-unix/NAME.so for Linux
# Wine, and in OUT/windows the same with x86_64-native/NAME.dll (an x64
# Windows DLL) for the Windows WoW64 port; the 32-bit callers sit at the
# top of both, beside copies of the builtins (Wine loads a builtin found on
# the Windows search path from WINEDLLPATH).
#
#   tools/wine-unixlib-fixtures OUT     (inside nix develop)
#
# * wine_unixlib_echo (crates/wine-unixlib-echo): the unixlib lookup and
#   20 calls. WINEDLLOVERRIDES=wine_unixlib_echo=b, run
#   wine-unixlib-echo-app.exe: ECHO_OK calls=20, exit 0.
# * wine_unixlib_window (crates/wine-unixlib-window): a winit/wgpu window on
#   a native thread, waited on by 32-bit callers, and exits while it draws.
#   WINEDLLOVERRIDES=wine_unixlib_window=b, run wine-unixlib-window-app.exe
#   wait | exit-live | worker-exit-live (markers in its source).
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
out=${1:?usage: tools/wine-unixlib-fixtures OUT}
target=${CARGO_TARGET_DIR:-$repo/target}
cd "$repo"
for crate in echo window; do
  name=wine_unixlib_$crate
  cargo build -q --release -p "wine-unixlib-$crate"
  cargo build -q --release -p "wine-unixlib-$crate" --target i686-pc-windows-gnu
  cargo build -q --release -p "wine-unixlib-$crate" --target x86_64-pc-windows-gnu
  for root in "$out" "$out/windows"; do
    mkdir -p "$root/i386-windows"
    cp -f "$target/i686-pc-windows-gnu/release/$name.dll" "$root/i386-windows/"
    tools/mark-wine-builtin "$root/i386-windows/$name.dll"
    cp -f "$root/i386-windows/$name.dll" "$root/"
    cp -f "$target/i686-pc-windows-gnu/release/wine-unixlib-$crate-app.exe" "$root/"
  done
  mkdir -p "$out/x86_64-unix" "$out/windows/x86_64-native"
  cp -f "$target/release/lib$name.so" "$out/x86_64-unix/$name.so"
  cp -f "$target/x86_64-pc-windows-gnu/release/$name.dll" "$out/windows/x86_64-native/$name.dll"
done
