#!/usr/bin/env bash
# Generates offsets and sizes of the game's (and C3X's) structs, computed by
# the 32-bit mingw compiler from C3X's reverse-engineered headers
# (Civ3Conquests.h, C3X.h), so no offset is ever transcribed by hand.
#
#   tools/gen-civ3-layout [C3X dir]      (run inside `nix develop`)
#
# writes crates/civ3-sys/src/layout.rs from crates/civ3-sys/layout.fields
# (the game's structs) and crates/civ3-sys/src/c3x_layout.rs from
# crates/civ3-sys/c3x.fields (C3X's own state; needs a C3X with districts,
# default the C3X source at /mnt/datasets/winvm/c3x-src). Field lists:
#   Struct                -> SIZE of the struct
#   Struct field.sub[3]   -> OFFSET of that member (any offsetof designator)
#   Struct field sizeof   -> its OFFSET and its SIZE
#   typedef Name c-type   -> names a type (e.g. `typedef State struct injected_state`)
#   value NAME c-expr     -> a constant (e.g. an enum value or a macro)
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
c3x=${1:-/mnt/datasets/winvm/c3x-src}
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

ident() { echo "$1" | tr '.[]' '___' | sed 's/__*/_/g; s/_$//' | tr '[:lower:]' '[:upper:]'; }

# generate FIELDS OUT DESCRIPTION
generate() {
  local fields=$1 out=$2 what=$3
  {
    echo '#include <stdio.h>'
    echo '#include <stddef.h>'
    echo "#include \"$c3x/C3X.h\""
    awk '$1 == "typedef" { $1 = ""; name = $2; $2 = ""; sub(/^ +/, ""); print "typedef " $0 " " name ";" }' "$fields"
    echo 'int main(void) {'
    while read -r struct member extra; do
      [[ -z "$struct" || "$struct" == \#* || "$struct" == typedef ]] && continue
      if [ "$struct" = value ]; then
        echo "  printf(\"pub const $(ident "$member"): i64 = %lld;\\n\", (long long)($extra));"
      elif [ -z "${member:-}" ]; then
        echo "  printf(\"pub const $(ident "$struct")_SIZE: u32 = %u;\\n\", (unsigned)sizeof($struct));"
      else
        echo "  printf(\"pub const $(ident "$struct")_$(ident "$member"): u32 = %u;\\n\", (unsigned)offsetof($struct, $member));"
        if [ "${extra:-}" = sizeof ]; then
          echo "  printf(\"pub const $(ident "$struct")_$(ident "$member")_SIZE: u32 = %u;\\n\", (unsigned)sizeof((($struct *)0)->$member));"
        fi
      fi
    done < "$fields"
    # Per struct, a table of the members exported with "sizeof":
    #   pub const <STRUCT>_FIELDS: &[(&str, u32, u32)] = &[(name, offset, size), ..];
    for s in $(awk '$3 == "sizeof" { print $1 }' "$fields" | sort -u); do
      echo "  printf(\"\\npub const $(ident "$s")_FIELDS: &[(&str, u32, u32)] = &[\\n\");"
      awk -v s="$s" '$1 == s && $3 == "sizeof" { print $2 }' "$fields" | while read -r m; do
        echo "  printf(\"    (\\\"$m\\\", %u, %u),\\n\", (unsigned)offsetof($s, $m), (unsigned)sizeof((($s *)0)->$m));"
      done
      echo "  printf(\"];\\n\");"
    done
    echo '  return 0;'
    echo '}'
  } > "$tmp/layout.c"
  i686-w64-mingw32-gcc -O0 -o "$tmp/layout.exe" "$tmp/layout.c" -w
  {
    echo "//! $what"
    echo '//!'
    echo '//! GENERATED by tools/gen-civ3-layout from C3X'"'"'s headers (mod'
    echo "//! version $(grep -m1 'MOD_VERSION' "$c3x/C3X.h" | tr -d '\r' | awk '{print $3}')) and $(basename "$fields"). Do not edit."
    echo
    "$repo/tools/wine-run" "$tmp/layout.exe" | tr -d '\r'
  } > "$out"
  echo "wrote $out ($(grep -c 'pub const' "$out") constants)"
}

generate "$repo/crates/civ3-sys/layout.fields" "$repo/crates/civ3-sys/src/layout.rs" \
  'Offsets and sizes of Civilization III: Conquests memory structures.'
generate "$repo/crates/civ3-sys/c3x.fields" "$repo/crates/civ3-sys/src/c3x_layout.rs" \
  "Offsets and sizes of C3X's own state (its districts), valid for the C3X
//! release they were generated from (see \`C3X_MOD_VERSION\`, \`STATE_SIZE\`)."
