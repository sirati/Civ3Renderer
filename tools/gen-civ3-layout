#!/usr/bin/env bash
# Generates crates/civ3-sys/src/layout.rs: offsets and sizes of the game's
# structs, computed by the 32-bit mingw compiler from C3X's reverse-engineered
# header (Civ3Conquests.h), so no offset is ever transcribed by hand.
#
#   tools/gen-civ3-layout [C3X dir]      (run inside `nix develop`)
#
# Fields to export are listed in crates/civ3-sys/layout.fields:
#   Struct                -> SIZE of the struct
#   Struct field.sub[3]   -> OFFSET of that member (any offsetof designator)
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
c3x=${1:-"/mnt/datasets/winvm/civ3-src/Civilization III Complete/Conquests"}
fields=$repo/crates/civ3-sys/layout.fields
out=$repo/crates/civ3-sys/src/layout.rs
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

ident() { echo "$1" | tr '.[]' '___' | sed 's/__*/_/g; s/_$//' | tr '[:lower:]' '[:upper:]'; }

{
  echo '#include <stdio.h>'
  echo '#include <stddef.h>'
  echo "#include \"$c3x/C3X.h\""
  echo 'int main(void) {'
  while read -r struct member; do
    [[ -z "$struct" || "$struct" == \#* ]] && continue
    if [ -z "${member:-}" ]; then
      echo "  printf(\"pub const $(ident "$struct")_SIZE: u32 = %u;\\n\", (unsigned)sizeof($struct));"
    else
      echo "  printf(\"pub const $(ident "$struct")_$(ident "$member"): u32 = %u;\\n\", (unsigned)offsetof($struct, $member));"
    fi
  done < "$fields"
  echo '  return 0;'
  echo '}'
} > "$tmp/layout.c"

i686-w64-mingw32-gcc -O0 -o "$tmp/layout.exe" "$tmp/layout.c" -w
{
  echo '//! Offsets and sizes of Civilization III: Conquests memory structures.'
  echo '//!'
  echo '//! GENERATED by tools/gen-civ3-layout from C3X'"'"'s Civ3Conquests.h (mod'
  echo "//! version $(grep -m1 'MOD_VERSION' "$c3x/C3X.h" | tr -d '\r' | awk '{print $3}')) and layout.fields. Do not edit."
  echo
  "$repo/tools/wine-run" "$tmp/layout.exe" | tr -d '\r'
} > "$out"
echo "wrote $out ($(grep -c 'pub const' "$out") constants)"
