    def test_install_registry_uses_32bit_private_paths_and_complete_flags(self):
        base, home, result=self.run_case()
        self.assertEqual(result.returncode,0,result.stderr)
        entries=[json.loads(line) for line in (base/'registry.jsonl').read_text().splitlines()]
        self.assertEqual(len(entries),5)
        self.assertTrue(all(entry['prefix']==str(home/'prefix') for entry in entries))
        for entry in entries:
            args=entry['argv']
            self.assertEqual(args[0:2],['reg.exe','add'])
            self.assertIn('/reg:32',args)
            value=args[args.index('/d')+1]
            if args[args.index('/t')+1]=='REG_SZ':
                self.assertTrue(value.startswith('Z:'+str(home).replace('/','\\')),value)
                self.assertNotIn('existing game',value)
            else: self.assertEqual(value,'1')
        self.assertTrue(entries[-1]['argv'][entries[-1]['argv'].index('/d')+1].endswith('\\'))

