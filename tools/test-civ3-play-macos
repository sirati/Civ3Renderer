    def test_launch_uses_private_writes_and_links_original_assets(self):
        base, home, result = self.run_case(extra=('--window','--scale','2'))
        self.assertEqual(result.returncode,0,result.stderr)
        capture=json.loads((base/'capture.json').read_text())
        private=Path(capture['cwd'])
        self.assertEqual(capture['env']['CIV3R_VIEWER'],'external')
        self.assertEqual(capture['env']['WGPU_BACKEND'],'metal')
        self.assertEqual(capture['env']['CIV3R_SCALE'],'2')
        self.assertEqual(capture['env']['CIV3R_SETTINGS'],str(home / 'settings.toml'))
        self.assertEqual(capture['env']['CIV3R_GAME_WINDOW'],'hide')
        self.assertEqual(capture['env']['CIV3R_GAME_RENDER'],'off')
        self.assertEqual(capture['env']['CIV3R_GAME_MAP'],'off')
        expected_cache='Z:'+str(home/'fonts').replace('/','\\')
        self.assertEqual(capture['env']['CIV3R_FONT_CACHE'],expected_cache)
        self.assertEqual(json.loads((base/'viewer-env.json').read_text())['font_cache'],expected_cache)
        self.assertTrue(capture['argv'][0].startswith('Z:\\'))
        self.assertTrue((private/'Civ3Conquests.exe').is_symlink())
        self.assertTrue((private/'Art').is_symlink())
        self.assertTrue((private.parent/'Art').is_symlink())
        self.assertTrue((private/'ifc23_orig.dll').is_symlink())
        self.assertEqual((private/'IFC23.dll').read_bytes(),b'new renderer interface')
        self.assertFalse((private/'Saves/Auto').is_symlink())

