value WDS_UNDER_CONSTRUCTION WDS_UNDER_CONSTRUCTION
value WDS_COMPLETED WDS_COMPLETED
value DRS_BY_COUNT DRS_BY_COUNT
value DRS_BY_BUILDING DRS_BY_BUILDING

