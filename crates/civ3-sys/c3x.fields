# C3X's own state (crates/civ3-sys/src/c3x.rs), from C3X.h of a release with
# districts (see tools/gen-civ3-layout). Valid only for that release: the
# reader checks the version and the state's size.

typedef State struct injected_state
typedef District struct district_instance
typedef DistrictConfig struct district_config
typedef DistrictInfos struct district_infos
typedef WonderConfig struct wonder_district_config
typedef NaturalWonderConfig struct natural_wonder_district_config
typedef Table struct table

value C3X_MOD_VERSION MOD_VERSION
value MAX_DISTRICT_TYPES COUNT_DISTRICT_TYPES
value MAX_WONDER_DISTRICTS MAX_WONDER_DISTRICT_TYPES
value MAX_NATURAL_WONDERS MAX_NATURAL_WONDER_DISTRICT_TYPES
value DS_COMPLETED DS_COMPLETED
value WDS_UNDER_CONSTRUCTION WDS_UNDER_CONSTRUCTION
value WDS_COMPLETED WDS_COMPLETED
value DRS_BY_COUNT DRS_BY_COUNT
value DRS_BY_BUILDING DRS_BY_BUILDING

State
State mod_version
State current_config.enable_districts
State current_config.enable_natural_wonders
State district_configs
State wonder_district_configs
State natural_wonder_configs
State district_tile_map
State district_infos
State district_count
